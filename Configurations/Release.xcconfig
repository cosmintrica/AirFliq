// Stable defaults for local Release builds. Xcode Cloud writes the ignored
// Secrets.xcconfig after cloning so the public RevenueCat key and monotonically
// increasing build number never need to be committed.
AIRFLIQ_REVENUECAT_API_KEY =
CURRENT_PROJECT_VERSION = 1
MARKETING_VERSION = 1.0.1

#include? "Secrets.xcconfig"
