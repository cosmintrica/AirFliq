<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Reading the Finder selection goes through Apple Events, which the
         hardened runtime blocks unless this is declared. -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
    <!-- Folder access is granted only through the user's NSOpenPanel choice and
         persisted as app-scoped security bookmarks. -->
    <key>com.apple.security.files.user-selected.read-only</key>
    <true/>
    <key>com.apple.security.files.bookmarks.app-scope</key>
    <true/>
    <key>com.apple.security.network.client</key>
    <true/>
</dict>
</plist>
